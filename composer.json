{
  "name": "nasimail/laravel-client",
  "description": "Laravel client package for NasiMail with API and Laravel Mail drivers.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.0",
    "illuminate/support": "^8.83|^9.0|^10.0|^11.0|^12.0",
    "illuminate/http": "^8.83|^9.0|^10.0|^11.0|^12.0",
    "illuminate/mail": "^8.83|^9.0|^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6|^10.5|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "NasiMail\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "NasiMail\\Laravel\\NasiMailServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
